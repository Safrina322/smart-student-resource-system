# Copy to .env and fill in real values. Never commit .env.

# Auth
JWT_SECRET=
ADMIN_JWT_SECRET=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=smartstudent
# Set to "true" for hosted providers that require TLS (e.g. Aiven). Leave
# unset for local MySQL, which typically isn't configured for it.
DB_SSL=

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# SMTP (approve/reject + scheduled report emails). Leave blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartStudent <no-reply@example.com>

# Cloudinary (file storage for course images, lesson resources, request images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini (AI study tools - summary, quiz, flashcards, chat, study
# planner, recommendations, search assist). Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
