# Copy to .env and fill in real values. Never commit .env.

# Auth
JWT_SECRET=

# MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=smartstudent

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# SMTP (approve/reject + scheduled report emails). Leave blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartStudent <no-reply@example.com>
